# Copy to .env and export, or set these in your shell. Every value is optional.

# Models. Mock mode needs no keys and makes no network calls.
GATEWAY_MOCK_LLM=true
MOCK_LATENCY_SCALE=1.0          # 0 disables simulated model latency
# To call real providers set GATEWAY_MOCK_LLM=false and the keys LiteLLM expects:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
PREMIUM_MODEL=gpt-4o
PREMIUM_FALLBACKS=anthropic/claude-sonnet-4-5
STANDARD_MODEL=groq/llama-3.1-8b-instant
STANDARD_FALLBACKS=anthropic/claude-haiku-4-5

# Prices in USD per million tokens (used for mock cost tracking and the baseline comparison).
PREMIUM_INPUT_COST_PER_M=5.00
PREMIUM_OUTPUT_COST_PER_M=15.00
STANDARD_INPUT_COST_PER_M=0.15
STANDARD_OUTPUT_COST_PER_M=0.60

# Policy thresholds.
GUARDRAIL_BLOCK_THRESHOLD=0.75
ROUTER_COMPLEXITY_THRESHOLD=0.50
FAITHFULNESS_THRESHOLD=0.70
RELEVANCE_THRESHOLD=0.50
EVAL_MODE=heuristic             # or llm_judge (real providers only)

# Auth. Leave unset for open local use.
# GATEWAY_API_KEY=
# GATEWAY_ADMIN_KEY=

# Tracing. Point at Arize Phoenix or any OTLP/HTTP collector.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Dashboard.
GATEWAY_API_URL=http://127.0.0.1:8000
